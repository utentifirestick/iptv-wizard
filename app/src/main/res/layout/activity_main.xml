<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#0F1318">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="IPTV - Configurazione"
        android:textColor="#EEF1F5"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="40dp"/>

    <Button
        android:id="@+id/btnTailscale"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="1. Installa Tailscale"
        android:textSize="20sp"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btnAccessibilita"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="2. Attiva Avvio Automatico"
        android:textSize="20sp"/>

</LinearLayout>
